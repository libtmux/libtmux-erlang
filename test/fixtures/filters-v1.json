{
  "version": 1,
  "graph": {
    "session": [
      {
        "id": "$1",
        "name": "work",
        "attachedCount": 2
      }
    ],
    "window": [
      {
        "id": "@1",
        "name": "separate"
      },
      {
        "id": "@2",
        "name": "both"
      },
      {
        "id": "@3",
        "name": "empty"
      }
    ],
    "windowLink": [
      {
        "sessionId": "$1",
        "windowId": "@1",
        "index": 0,
        "active": true
      },
      {
        "sessionId": "$1",
        "windowId": "@1",
        "index": 3,
        "active": false
      },
      {
        "sessionId": "$1",
        "windowId": "@2",
        "index": 1,
        "active": false
      },
      {
        "sessionId": "$1",
        "windowId": "@3",
        "index": 2,
        "active": false
      }
    ],
    "pane": [
      {
        "id": "%1",
        "windowId": "@1",
        "index": 0,
        "active": true,
        "currentCommand": "cat",
        "width": 80,
        "pid": 101,
        "title": "café",
        "currentPath": {
          "base64": "L3RtcC9h"
        }
      },
      {
        "id": "%2",
        "windowId": "@1",
        "index": 1,
        "active": false,
        "currentCommand": "vim",
        "width": 120,
        "pid": null,
        "title": "CAFE",
        "currentPath": {
          "base64": "AP8="
        }
      },
      {
        "id": "%3",
        "windowId": "@2",
        "index": 0,
        "active": true,
        "currentCommand": "vim",
        "width": 100,
        "pid": 201,
        "title": "café",
        "currentPath": {
          "base64": "L3RtcC9i"
        }
      }
    ]
  },
  "cases": [
    {
      "name": "numeric physical order",
      "filter": {
        "version": 1,
        "entity": "window",
        "where": {}
      },
      "expected": [
        "@1",
        "@2",
        "@3"
      ]
    },
    {
      "name": "correlated existential",
      "filter": {
        "version": 1,
        "entity": "window",
        "where": {
          "panes": {
            "some": {
              "active": true,
              "currentCommand": "vim"
            }
          }
        }
      },
      "expected": [
        "@2"
      ]
    },
    {
      "name": "independent existentials",
      "filter": {
        "version": 1,
        "entity": "window",
        "where": {
          "and": [
            {
              "panes": {
                "some": {
                  "active": true
                }
              }
            },
            {
              "panes": {
                "some": {
                  "currentCommand": "vim"
                }
              }
            }
          ]
        }
      },
      "expected": [
        "@1",
        "@2"
      ]
    },
    {
      "name": "every includes empty",
      "filter": {
        "version": 1,
        "entity": "window",
        "where": {
          "panes": {
            "every": {
              "active": true
            }
          }
        }
      },
      "expected": [
        "@2",
        "@3"
      ]
    },
    {
      "name": "none includes empty",
      "filter": {
        "version": 1,
        "entity": "window",
        "where": {
          "panes": {
            "none": {
              "currentCommand": "vim"
            }
          }
        }
      },
      "expected": [
        "@3"
      ]
    },
    {
      "name": "complete relationship count",
      "filter": {
        "version": 1,
        "entity": "window",
        "where": {
          "panes": {
            "count": {
              "gte": 2
            }
          }
        }
      },
      "expected": [
        "@1"
      ]
    },
    {
      "name": "physical versus membership count",
      "filter": {
        "version": 1,
        "entity": "session",
        "where": {
          "windows": {
            "count": 3
          },
          "windowLinks": {
            "count": 4
          }
        }
      },
      "expected": [
        "$1"
      ]
    },
    {
      "name": "to-one complement",
      "filter": {
        "version": 1,
        "entity": "pane",
        "where": {
          "window": {
            "is_not": {
              "name": "both"
            }
          }
        }
      },
      "expected": [
        "%1",
        "%2"
      ]
    },
    {
      "name": "known absence",
      "filter": {
        "version": 1,
        "entity": "pane",
        "where": {
          "pid": null
        }
      },
      "expected": [
        "%2"
      ]
    },
    {
      "name": "explicit absence",
      "filter": {
        "version": 1,
        "entity": "pane",
        "where": {
          "pid": {
            "present": false
          }
        }
      },
      "expected": [
        "%2"
      ]
    },
    {
      "name": "negated comparison includes absence",
      "filter": {
        "version": 1,
        "entity": "pane",
        "where": {
          "not": {
            "pid": {
              "gt": 150
            }
          }
        }
      },
      "expected": [
        "%1",
        "%2"
      ]
    },
    {
      "name": "integral membership normalization",
      "filter": {
        "version": 1,
        "entity": "pane",
        "where": {
          "width": {
            "in": [
              120.0,
              80,
              80
            ]
          }
        }
      },
      "expected": [
        "%1",
        "%2"
      ]
    },
    {
      "name": "arbitrary bytes equality",
      "filter": {
        "version": 1,
        "entity": "pane",
        "where": {
          "currentPath": {
            "base64": "AP8="
          }
        }
      },
      "expected": [
        "%2"
      ]
    },
    {
      "name": "arbitrary bytes prefix",
      "filter": {
        "version": 1,
        "entity": "pane",
        "where": {
          "currentPath": {
            "starts_with": {
              "base64": "AA=="
            }
          }
        }
      },
      "expected": [
        "%2"
      ]
    },
    {
      "name": "case-sensitive text",
      "filter": {
        "version": 1,
        "entity": "pane",
        "where": {
          "title": {
            "starts_with": "caf"
          }
        }
      },
      "expected": [
        "%1",
        "%3"
      ]
    },
    {
      "name": "no Unicode normalization",
      "filter": {
        "version": 1,
        "entity": "pane",
        "where": {
          "title": {
            "contains": "é"
          }
        }
      },
      "expected": [
        "%1"
      ]
    },
    {
      "name": "empty substring",
      "filter": {
        "version": 1,
        "entity": "pane",
        "where": {
          "title": {
            "contains": ""
          }
        }
      },
      "expected": [
        "%1",
        "%2",
        "%3"
      ]
    },
    {
      "name": "empty AND",
      "filter": {
        "version": 1,
        "entity": "pane",
        "where": {
          "and": []
        }
      },
      "expected": [
        "%1",
        "%2",
        "%3"
      ]
    },
    {
      "name": "empty OR",
      "filter": {
        "version": 1,
        "entity": "pane",
        "where": {
          "or": []
        }
      },
      "expected": []
    },
    {
      "name": "strict equality and range",
      "filter": {
        "version": 1,
        "entity": "pane",
        "where": {
          "width": {
            "gte": 80.0,
            "lt": 120
          }
        }
      },
      "expected": [
        "%1",
        "%3"
      ]
    },
    {
      "name": "membership inequality",
      "filter": {
        "version": 1,
        "entity": "pane",
        "where": {
          "currentCommand": {
            "not_in": [
              "vim"
            ]
          }
        }
      },
      "expected": [
        "%1"
      ]
    },
    {
      "name": "attached is derived from client count",
      "filter": {
        "version": 1,
        "entity": "session",
        "where": {
          "attached": true,
          "attachedCount": {
            "gt": 1
          }
        }
      },
      "expected": [
        "$1"
      ]
    },
    {
      "name": "portable ASCII command regex",
      "filter": {
        "version": 1,
        "entity": "pane",
        "where": {
          "currentCommand": {
            "regex": {
              "pattern": "^(vim|nvim)$",
              "flags": [],
              "dialect": "portable_v1"
            }
          }
        }
      },
      "expected": [
        "%2",
        "%3"
      ]
    }
  ],
  "invalid": [
    {
      "name": "typed operator rejection",
      "filter": {
        "version": 1,
        "entity": "pane",
        "where": {
          "active": {
            "contains": "yes"
          }
        }
      },
      "code": "unsupported_operator",
      "path": [
        "where",
        "active",
        "contains"
      ]
    },
    {
      "name": "numeric string rejection",
      "filter": {
        "version": 1,
        "entity": "pane",
        "where": {
          "width": "80"
        }
      },
      "code": "invalid_value",
      "path": [
        "where",
        "width"
      ]
    },
    {
      "name": "nonintegral number rejection",
      "filter": {
        "version": 1,
        "entity": "pane",
        "where": {
          "width": 1.5
        }
      },
      "code": "invalid_value",
      "path": [
        "where",
        "width"
      ]
    },
    {
      "name": "nonnullable absence rejection",
      "filter": {
        "version": 1,
        "entity": "pane",
        "where": {
          "active": null
        }
      },
      "code": "invalid_value",
      "path": [
        "where",
        "active"
      ]
    },
    {
      "name": "unknown nested field",
      "filter": {
        "version": 1,
        "entity": "window",
        "where": {
          "panes": {
            "some": {
              "unknown": true
            }
          }
        }
      },
      "code": "unknown_field",
      "path": [
        "where",
        "panes",
        "some",
        "unknown"
      ]
    },
    {
      "name": "invalid negation child",
      "filter": {
        "version": 1,
        "entity": "pane",
        "where": {
          "not": []
        }
      },
      "code": "expected_object",
      "path": [
        "where",
        "not"
      ]
    },
    {
      "name": "wrong relationship quantifier",
      "filter": {
        "version": 1,
        "entity": "pane",
        "where": {
          "window": {
            "some": {}
          }
        }
      },
      "code": "unsupported_operator",
      "path": [
        "where",
        "window",
        "some"
      ]
    },
    {
      "name": "unknown regex dialect",
      "filter": {
        "version": 1,
        "entity": "pane",
        "where": {
          "title": {
            "regex": {
              "dialect": "portable_v2",
              "pattern": "a",
              "flags": []
            }
          }
        }
      },
      "code": "unsupported_dialect",
      "path": [
        "where",
        "title",
        "regex",
        "dialect"
      ]
    }
  ]
}
