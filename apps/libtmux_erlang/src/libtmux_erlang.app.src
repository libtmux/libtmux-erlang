{application, libtmux_erlang, [
    {description, "Native Erlang values and explicit tmux operations"},
    {vsn, "0.0.0+development"},
    {licenses, ["MIT"]},
    {links, #{"GitHub" => "https://github.com/libtmux/libtmux-erlang"}},
