{minimum_otp_vsn, "29.1.2"}.
{project_app_dirs, ["apps/*"]}.
{erl_opts, [debug_info, deterministic, warnings_as_errors, warn_missing_spec]}.
{deps, []}.
{extra_src_dirs, [{"scripts", [{recursive, true}]}]}.
{profiles, [{release, [
    {plugins, [{rebar3_hex, "7.5.0"}]}
]}, {test, [
    {deps, [{erlexec, "2.6.0"}]}
]}, {property, [
    {deps, [{proper, "1.5.0"}]},
    {plugins, [{rebar3_proper, "0.12.1"}]},
    {extra_src_dirs, ["property"]}
]}]}.
{eunit_opts, [verbose]}.
{eunit_tests, [{application, libtmux_erlang}, {dir, "scripts"}]}.
{ct_opts, [{dir, ["test", "scripts/helper/tests"]}, {ct_hooks, [tmux_test_sandbox]}]}.
{dialyzer, [{warnings, [unmatched_returns, error_handling]},
            {plt_extra_apps, [crypto, common_test, eunit, inets, ssl,
                             public_key, compiler, tools]}]}.
