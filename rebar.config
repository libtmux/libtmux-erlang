{minimum_otp_vsn, "29.1.2"}.
{project_app_dirs, ["apps/*"]}.
{erl_opts, [debug_info, deterministic, warnings_as_errors, warn_missing_spec]}.
{deps, []}.
{escript_main_app, libtmux_erlang_workspace}.
{escript_name, "libtmux-workspace"}.
{escript_emu_args, "%%! +S 4:4 -escript main tmux_workspace_cli\n"}.
{escript_incl_priv, [{libtmux_erlang, "*"}]}.
{profiles, [{property, [
    {deps, [{proper, "1.5.0"}]},
    {plugins, [{rebar3_proper, "0.12.1"}]},
    {extra_src_dirs, ["property"]}
]}]}.
{eunit_opts, [verbose]}.
{dialyzer, [{warnings, [unmatched_returns, error_handling]},
            {plt_extra_apps, [crypto, common_test]}]}.
